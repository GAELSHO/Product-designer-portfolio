---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TituloRotativo from '@/components/TituloRotativo.astro';
import TarjetaProyecto from '@/components/TarjetaProyecto.astro';
import Servicios from '@/components/Servicios.astro';
import { getCollection } from 'astro:content';
import { withBase } from '@/lib/url';
import { Image } from 'astro:assets';
import fotoAbout from '@/assets/aboutme.png';
import Vinilo from '@/components/Vinilo.astro';

const proyectos = (await getCollection('work')).sort((a, b) => a.data.orden - b.data.orden);

---

<BaseLayout title="Gael SHO | Brand Designer">
  {/* El hero ocupa casi toda la primera pantalla; la card destacada asoma por
      debajo para que se note que hay más contenido. El `svh` (y no `vh`) es
      para que en móvil cuente el alto real con la barra del navegador. */}
  <header class="flex min-h-[68svh] flex-col items-center justify-center sm:min-h-[64svh]">
    <TituloRotativo />

    {/* El salto va en el markup y no vía `max-width`: dónde parte una caja de
        ancho fijo depende de la métrica de la fuente, y con Poppins cargando
        tarde el corte bailaba. En móvil el `<br>` se apaga y envuelve solo. */}
    {/* Tamaño fluido, como el `<h1>`: con un tamaño fijo la descripción crecía
        en proporción al bajar de ancho (en móvil llegaba a 0.67 del título, y
        en la referencia es ~0.33). El `2.05vw` es 0.33 × el `6.2vw` del título,
        así que la proporción se mantiene constante mientras ambos escalan.
        El suelo de 0.875rem es legibilidad: a 390px de ancho el título mide
        24px y un 0.33 de eso serían 8px, ilegibles. Por eso en móvil la
        proporción no se puede respetar.

        El tope de ancho en móvil va en % y no en `ch`: ahí el título ocupa casi
        todo el ancho disponible, así que un 86% del contenedor deja la
        descripción siempre más corta. En `ch` dependería de la métrica de
        Poppins y se pasaba de largo. */}
    <p
      class="text-ink-700 mt-5 max-w-[86%] text-center text-[clamp(0.875rem,2.05vw,1.5rem)] font-light text-pretty sm:mt-6 sm:max-w-[80ch]"
    >
      Helping startups and businesses build everything<br class="hidden sm:inline" /> from identity
      to interface.
    </p>

    {/* La flecha es el indicador de scroll, así que además de señalar, lleva. */}
    <a
      href={withBase('/#work')}
      class="text-ink-700 hover:text-ink-950 mt-14 transition-colors sm:mt-20"
      aria-label="Skip to selected work"
    >
      <svg
        class="size-8 sm:size-10"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.25"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m5 9 7 7 7-7" />
      </svg>
    </a>
  </header>

  <section id="work" class="mt-16 scroll-mt-28">
    <h2 class="sr-only">Selected work</h2>

    {/* Una card debajo de otra, también en desktop. */}
    <div class="grid gap-4 sm:gap-6">
      {
        proyectos.map((proyecto, i) => (
          <TarjetaProyecto slug={proyecto.id} datos={proyecto.data} prioritaria={i === 0} />
        ))
      }
    </div>
  </section>

  <Servicios />

  <section id="about" class="mt-24 scroll-mt-28">
    {/* Mismo peso que "Our Services": título grande en mayúsculas con una
        línea debajo, no la etiqueta pequeña que llevaba antes. */}
    <h2 class="text-[clamp(2.25rem,5.5vw,3.75rem)] font-semibold tracking-tight uppercase">
      About Me
    </h2>

    {/* Foto arriba y música debajo en móvil; en desktop van a dos columnas, la
        misma ruptura (`lg:`) que usa Servicios para su columna fija + cards.
        La foto se lleva algo más de ancho porque es la pieza con el texto
        dentro: el disco no gana nada por crecer. */}
    <div
      class="border-ink-100 mt-8 grid gap-14 border-t pt-14 sm:pt-20 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:items-center lg:gap-16"
    >
      {/* La nota de papel ya lleva su propia sombra y su borde irregular, así
          que va sin marco ni radio propios —cualquiera de los dos se vería
          encima del que trae la pieza—. El `alt` no es decorativo: repite la
          frase de la nota, que es el único texto real que trae la imagen. */}
      <Image
        src={fotoAbout}
        alt="Gael SHO standing in front of a whiteboard covered in colour-coded sticky notes, with a torn paper note clipped over the photo reading: I'm a 24-year-old designer passionate about combining design and software development to solve real-world problems."
        widths={[400, 600, 800, 1100]}
        sizes="(min-width: 64rem) 36rem, (min-width: 40rem) 28rem, 85vw"
        class="mx-auto w-full max-w-md lg:mx-0 lg:max-w-xl"
        loading="lazy"
      />

      <div>
        <h3 class="text-[clamp(1.75rem,3.5vw,2.75rem)] leading-tight font-semibold tracking-tight">
          I love music
        </h3>
        <p class="text-ink-700 mt-3 font-light">What I&rsquo;ve been hearing lately.</p>

        <Vinilo class="mt-10" />
      </div>
    </div>
  </section>
</BaseLayout>
