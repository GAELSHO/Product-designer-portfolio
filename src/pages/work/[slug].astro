---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/url';

export async function getStaticPaths() {
  const proyectos = await getCollection('work');
  return proyectos.map((proyecto) => ({
    params: { slug: proyecto.id },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const { titulo, descripcion, intro, tags, cliente, anio } = proyecto.data;

// La card de la home necesita una línea corta; aquí hay sitio para la frase
// entera, así que el case study usa `intro` cuando existe.
const subtitulo = intro ?? descripcion;

const ficha = [
  { etiqueta: 'Client', valor: cliente },
  { etiqueta: 'Year', valor: anio },
].filter((f) => f.valor);

// Los tags van en píldoras, que el buscador no lee como disciplinas del
// proyecto; en la meta sí conviene nombrarlas.
const descripcionMeta = `${subtitulo}. ${tags.join(', ')}.`;
---

<BaseLayout title={`${titulo} — Gael SHO`} description={descripcionMeta}>
  <article>
    <a class="text-ink-500 hover:text-ink-950 text-sm transition-colors" href={withBase('/#work')}>
      ← Work
    </a>

    <header class="mt-6 border-b border-ink-100 pb-10 sm:pb-14">
      {/* Mismo tamaño fluido que el título de la home: tiene que caber sin
          partirse desde 320px, y `text-5xl` fijo se partía en móvil. */}
      <h1 class="text-[clamp(2rem,7vw,4.5rem)] font-semibold tracking-tight text-balance">
        {titulo}
      </h1>
      <p class="text-ink-700 mt-4 max-w-[46ch] text-lg font-light text-pretty">{subtitulo}</p>

      {/* En móvil la ficha se apila; en desktop va en fila. Es texto, no una
          imagen, así que nunca se reduce: se reordena. */}
      <dl class="mt-8 flex flex-col gap-6 sm:flex-row sm:gap-16">
        {
          ficha.map((f) => (
            <div>
              <dt class="text-ink-500 text-xs font-medium tracking-widest uppercase">
                {f.etiqueta}
              </dt>
              <dd class="mt-1.5">{f.valor}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    {/*
      El cuerpo del case study. Los estilos van aquí y no en cada elemento del
      markdown, porque el `.md` solo debería llevar contenido.

      Las imágenes salen a ancho completo del contenedor; las verticales se
      quedan más estrechas y centradas para no medir 1300px de alto en desktop.
      Eso lo decide la propia imagen con `max-h`, sin tener que marcarla a mano.
    */}
    <div class="cuerpo mt-12 sm:mt-16">
      <Content />
    </div>

    <a
      class="text-ink-500 hover:text-ink-950 mt-20 inline-block text-sm transition-colors"
      href={withBase('/#work')}
    >
      ← Back to work
    </a>
  </article>
</BaseLayout>

<style>
  .cuerpo :global(h2) {
    font-size: clamp(1.5rem, 3.2vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-block: 4rem 1rem;
    max-width: 24ch;
  }

  .cuerpo :global(h2:first-child) {
    margin-block-start: 0;
  }

  .cuerpo :global(h3) {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 500;
    margin-block: 2.5rem 0.75rem;
  }

  /* La columna de lectura se queda estrecha aunque las imágenes vayan anchas:
     una línea de 1104px de ancho es incómoda de leer. */
  .cuerpo :global(p),
  .cuerpo :global(ul),
  .cuerpo :global(ol) {
    max-width: 62ch;
    margin-block: 1rem;
    font-weight: 300;
    color: var(--color-ink-700);
    text-wrap: pretty;
  }

  .cuerpo :global(ul) {
    list-style: disc;
    padding-inline-start: 1.25rem;
  }

  .cuerpo :global(li) {
    margin-block: 0.375rem;
  }

  .cuerpo :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Astro envuelve cada imagen suelta del markdown en su propio <p>. */
  .cuerpo :global(p:has(> img)) {
    max-width: none;
  }

  /*
    Los boards van pegados entre sí: son composiciones continuas, así que
    cualquier hueco entre ellos rompe la lectura. Sin margen y sin sombra.
  */
  .cuerpo :global(.pieza) {
    display: block;
    width: 100%;
    margin-block: 0;
  }

  .cuerpo :global(.pieza img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
    La secuencia se queda dentro de la columna de <main> en vez de ir a sangre.
    Dos razones, y la segunda es la que manda:

    1. El aire lateral la lee como una pieza y no como un fondo de página.
    2. A sangre el board se pinta a 100vw, así que una pantalla retina pedía la
       variante de 2880px y subiendo. En la columna se pinta a 1104px como
       máximo, y a igualdad de archivo eso es **más densidad de píxel**: se ve
       más nítido y además pesa menos. Está medido.

    El radio solo en los extremos: por dentro las piezas siguen a tope.
  */
  .cuerpo :global(.secuencia .pieza:first-child img) {
    border-start-start-radius: 1.5rem;
    border-start-end-radius: 1.5rem;
  }

  .cuerpo :global(.secuencia .pieza:last-child img) {
    border-end-start-radius: 1.5rem;
    border-end-end-radius: 1.5rem;
  }

  /*
    Si tras las secuencias viene un cierre en código, la pila no termina en un
    board: el radio de abajo pasa a esa pieza y el último board se queda a
    escuadra para que las dos se lean como una sola columna continua. El `~` y
    no el `+` porque hay dos secuencias y el cierre solo sigue a la segunda.
  */
  .cuerpo :global(.secuencia:has(~ .cierre) .pieza:last-child img) {
    border-end-start-radius: 0;
    border-end-end-radius: 0;
  }

  /*
    Las dos secuencias completas: solo se muestra una. La otra queda en
    `display:none`, y como sus imágenes son `loading="lazy"` nunca entran en
    viewport, así que el navegador no las descarga.
  */
  .cuerpo :global(.secuencia-desktop) {
    display: none;
  }

  @media (min-width: 40rem) {
    .cuerpo :global(.secuencia-movil) {
      display: none;
    }

    .cuerpo :global(.secuencia-desktop) {
      display: block;
    }
  }

  /*
    En desktop, un board compuesto a proporción de teléfono no se estira ni
    al ancho de la columna: mediría más de 1800px de alto. Se queda en una
    columna centrada del ancho de un móvil.
  */
  @media (min-width: 40rem) {
    .cuerpo :global(.pieza-movil) {
      max-width: 32rem;
      margin-inline: auto;
    }
  }

  /* Imágenes sueltas del markdown (no boards), por si vuelve a haber texto
     con ilustraciones intercaladas. */
  .cuerpo :global(p > img) {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 85svh;
    height: auto;
    margin-inline: auto;
    margin-block: 3rem;
    border-radius: 1rem;
  }
</style>
