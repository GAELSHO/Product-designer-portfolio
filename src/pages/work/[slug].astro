---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/url';

export async function getStaticPaths() {
  const proyectos = await getCollection('work');
  return proyectos.map((proyecto) => ({
    params: { slug: proyecto.id },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const { titulo, descripcion, tags, cliente, anio } = proyecto.data;

const ficha = [
  { etiqueta: 'Client', valor: cliente },
  { etiqueta: 'Year', valor: anio },
].filter((f) => f.valor);

// `descripcion` es deliberadamente corta porque es lo que se lee sobre la card
// de la home, donde las píldoras ya dicen las disciplinas. Para el buscador eso
// solo son tres palabras, así que aquí se le añaden los tags.
const descripcionMeta = `${titulo} — ${descripcion}. ${tags.join(', ')}.`;
---

<BaseLayout title={`${titulo} — Gael SHO`} description={descripcionMeta}>
  <article>
    <a class="text-ink-500 hover:text-ink-950 text-sm transition-colors" href={withBase('/#work')}>
      ← Work
    </a>

    <header class="mt-6 border-b border-ink-100 pb-10 sm:pb-14">
      {/* Mismo tamaño fluido que el título de la home: tiene que caber sin
          partirse desde 320px, y `text-5xl` fijo se partía en móvil. */}
      <h1 class="text-[clamp(2rem,7vw,4.5rem)] font-semibold tracking-tight text-balance">
        {titulo}
      </h1>
      <p class="text-ink-700 mt-4 max-w-[46ch] text-lg font-light text-pretty">{descripcion}</p>

      {/* En móvil la ficha se apila; en desktop va en fila. Es texto, no una
          imagen, así que nunca se reduce: se reordena. */}
      <dl class="mt-8 flex flex-col gap-6 sm:flex-row sm:gap-16">
        {
          ficha.map((f) => (
            <div>
              <dt class="text-ink-500 text-xs font-medium tracking-widest uppercase">
                {f.etiqueta}
              </dt>
              <dd class="mt-1.5">{f.valor}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    {/*
      El cuerpo del case study. Los estilos van aquí y no en cada elemento del
      markdown, porque el `.md` solo debería llevar contenido.

      Las imágenes salen a ancho completo del contenedor; las verticales se
      quedan más estrechas y centradas para no medir 1300px de alto en desktop.
      Eso lo decide la propia imagen con `max-h`, sin tener que marcarla a mano.
    */}
    <div class="cuerpo mt-12 sm:mt-16">
      <Content />
    </div>

    <a
      class="text-ink-500 hover:text-ink-950 mt-20 inline-block text-sm transition-colors"
      href={withBase('/#work')}
    >
      ← Back to work
    </a>
  </article>
</BaseLayout>

<style>
  .cuerpo :global(h2) {
    font-size: clamp(1.5rem, 3.2vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-block: 4rem 1rem;
    max-width: 24ch;
  }

  .cuerpo :global(h2:first-child) {
    margin-block-start: 0;
  }

  .cuerpo :global(h3) {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 500;
    margin-block: 2.5rem 0.75rem;
  }

  /* La columna de lectura se queda estrecha aunque las imágenes vayan anchas:
     una línea de 1104px de ancho es incómoda de leer. */
  .cuerpo :global(p),
  .cuerpo :global(ul),
  .cuerpo :global(ol) {
    max-width: 62ch;
    margin-block: 1rem;
    font-weight: 300;
    color: var(--color-ink-700);
    text-wrap: pretty;
  }

  .cuerpo :global(ul) {
    list-style: disc;
    padding-inline-start: 1.25rem;
  }

  .cuerpo :global(li) {
    margin-block: 0.375rem;
  }

  .cuerpo :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Astro envuelve cada imagen suelta del markdown en su propio <p>. */
  .cuerpo :global(p:has(> img)) {
    max-width: none;
  }

  /*
    Los boards van pegados: son composiciones continuas, así que cualquier
    hueco entre ellos rompe la lectura. Sin margen, sin radio y sin sombra.
  */
  .cuerpo :global(.pieza) {
    display: block;
    margin-block: 0;
  }

  .cuerpo :global(.pieza img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
    A sangre: se sale del padding lateral de <main> hasta tocar los dos bordes
    de la pantalla. El `max-width` evita que el ancho del scrollbar provoque
    scroll horizontal en los navegadores que lo pintan por encima del layout.
  */
  .cuerpo :global(.pieza) {
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  /*
    En desktop, un board compuesto a proporción de teléfono no se estira: a
    ancho completo mediría más de 1800px de alto. Se queda en una columna
    centrada del ancho de un móvil, y ahí sí lleva radio porque ya no toca los
    bordes de la pantalla.
  */
  @media (min-width: 40rem) {
    .cuerpo :global(.pieza-movil) {
      width: 100%;
      max-width: 32rem;
      margin-inline: auto;
    }

    .cuerpo :global(.pieza-movil:first-child img) {
      border-start-start-radius: 1.5rem;
      border-start-end-radius: 1.5rem;
    }

    .cuerpo :global(.pieza-movil:last-child img) {
      border-end-start-radius: 1.5rem;
      border-end-end-radius: 1.5rem;
    }
  }

  /* Imágenes sueltas del markdown (no boards), por si vuelve a haber texto
     con ilustraciones intercaladas. */
  .cuerpo :global(p > img) {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 85svh;
    height: auto;
    margin-inline: auto;
    margin-block: 3rem;
    border-radius: 1rem;
  }
</style>
