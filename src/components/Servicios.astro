---
/**
 * Sección de servicios de la home. El contenido sale de los documentos de
 * precios del estudio (SHO-BR / SHO-CP / SHO-RS), sin los precios: aquí la
 * sección presenta el servicio, no cotiza.
 *
 * Jerarquía sin sombras (sobre #191919 no se ven): los paquetes van en cards
 * con superficie `ink-50`, y el recomendado se invierte a crema (`ink-950`),
 * que es el mayor contraste disponible en la paleta. Las cifras grandes
 * (03 poses, 05 applications) replican la ficha de los documentos originales.
 */
const servicios = [
  {
    numero: '01',
    titulo: 'Brand Identity',
    descripcion:
      'Visual identity from logo to real-world applications. Choose between two packages: essential basics or a complete brand ready to launch.',
    paquetes: [
      {
        nombre: 'Essential',
        detalle: 'The essentials to get started',
        incluye: [
          'Logo design',
          'Logo variants',
          'Colour palette',
          'Typography',
          'Brand presentation',
          'Profile picture and cover for social media',
          'Story highlight covers',
          'Ready-to-use files',
        ],
      },
      {
        nombre: 'Complete',
        detalle: 'Everything ready for opening day',
        destacado: true,
        incluye: [
          'Everything in Essential',
          'Initial social media post design',
          'Brand applications tailored to your business',
          'Complete brand manual',
          'Files ready for print and digital media',
        ],
        cifras: [
          { n: '05', etiqueta: 'Applications' },
          { n: '01', etiqueta: 'Brand manual' },
        ],
      },
    ],
  },
  {
    numero: '02',
    titulo: 'Character Design',
    descripcion:
      'A mascot with a personality of its own for your brand. Original design, ready-to-use poses, and files delivered in the formats you need.',
    paquetes: [
      {
        nombre: 'Essential',
        detalle: 'Character and essential poses',
        incluye: [
          'Original character design',
          'Versions for light and dark backgrounds',
          'Delivery in transparent PNG',
        ],
        cifras: [{ n: '03', etiqueta: 'Poses' }],
      },
      {
        nombre: 'Complete',
        detalle: 'With animation and stickers',
        destacado: true,
        incluye: [
          'Original character design',
          'Animated GIFs for stories and social media',
          'Sticker version',
          'Print-ready sticker files',
          'Delivery in PNG, GIF and JPG',
        ],
        cifras: [
          { n: '04', etiqueta: 'Poses' },
          { n: '02', etiqueta: 'Animated GIFs' },
        ],
      },
    ],
  },
  {
    numero: '03',
    titulo: 'Social Media',
    descripcion:
      'Monthly strategy, design and publishing to build a consistent presence and grow the brand. Plans start at three months to ensure consistency.',
    paquetes: [
      {
        nombre: 'Essential plan',
        detalle: 'Monthly · strategy and ongoing content',
        incluye: [
          'Content strategy',
          'Monthly planning and publishing calendar',
          'Content design and copywriting',
          'Scheduling and publishing',
        ],
        cifras: [{ n: '12', etiqueta: 'Posts a month' }],
      },
      {
        nombre: 'Full plan',
        detalle: 'Monthly · content, photo and video',
        destacado: true,
        incluye: [
          'Everything in the Essential plan',
          'Monthly photo and video session',
          'Photo and video editing',
          'Content adapted for social media',
        ],
        cifras: [
          { n: '12', etiqueta: 'Posts a month' },
          { n: '01', etiqueta: 'Photo session' },
        ],
      },
    ],
  },
];
---

<section id="services" class="mt-24 scroll-mt-28">
  {/* Título de sección al peso de la casa: grande y en mayúsculas, con la
      línea debajo. Las líneas entre servicios las pone el divide-y. */}
  <h2 class="text-[clamp(2.25rem,5.5vw,3.75rem)] font-semibold tracking-tight uppercase">
    Our Services
  </h2>

  <div class="border-ink-100 divide-ink-100 mt-8 divide-y border-t">
    {
      servicios.map((servicio) => (
        <article class="grid gap-8 py-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:gap-16 sm:py-20">
          {/* Columna izquierda: 01.Título en grande, descripción y nota.
              En desktop se queda pegada mientras las cards hacen scroll. */}
          <div class="lg:sticky lg:top-24 lg:self-start">
            <h3 class="text-[clamp(1.75rem,3.5vw,2.75rem)] leading-tight font-semibold tracking-tight text-balance">
              <span class="text-ink-500">{servicio.numero}.</span>{servicio.titulo}
            </h3>
            <p class="text-ink-700 mt-5 max-w-[46ch] font-light text-pretty">
              {servicio.descripcion}
            </p>
            {servicio.nota && (
              <p class="text-ink-500 mt-5 max-w-[46ch] text-sm font-light text-pretty">
                {servicio.nota}
              </p>
            )}
          </div>

          {/* Columna derecha: las cards una encima de otra. */}
          <div class="flex flex-col gap-4 sm:gap-6">
            {servicio.paquetes.map((paquete) => (
              <div
                class={
                  paquete.destacado
                    ? 'tarjeta-magica magica-clara bg-ink-950 text-background flex flex-col rounded-3xl p-7 sm:rounded-[2rem] sm:p-9'
                    : 'tarjeta-magica magica-oscura bg-ink-50 border-ink-100 flex flex-col rounded-3xl border p-7 sm:rounded-[2rem] sm:p-9'
                }
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h4 class="text-xl font-medium tracking-tight sm:text-2xl">
                      {paquete.nombre}
                    </h4>
                    <p
                      class={
                        paquete.destacado
                          ? 'text-background/60 mt-1 text-sm font-light'
                          : 'text-ink-500 mt-1 text-sm font-light'
                      }
                    >
                      {paquete.detalle}
                    </p>
                  </div>
                  {paquete.destacado && (
                    <span class="border-background/25 mt-1 shrink-0 rounded-full border px-3 py-1 text-[10px] font-medium tracking-widest uppercase">
                      Recommended
                    </span>
                  )}
                </div>

                <ul class="mt-7 mb-8 flex flex-col gap-2.5">
                  {paquete.incluye.map((item) => (
                    <li
                      class={
                        paquete.destacado
                          ? 'text-background/80 flex gap-3 font-light'
                          : 'text-ink-700 flex gap-3 font-light'
                      }
                    >
                      <span
                        class={
                          paquete.destacado
                            ? 'text-background/35 select-none'
                            : 'text-ink-300 select-none'
                        }
                        aria-hidden="true"
                      >
                        —
                      </span>
                      {item}
                    </li>
                  ))}
                </ul>

                {paquete.cifras && (
                  <div
                    class={
                      paquete.destacado
                        ? 'border-background/15 mt-auto flex gap-10 border-t pt-6 sm:gap-14'
                        : 'border-ink-100 mt-auto flex gap-10 border-t pt-6 sm:gap-14'
                    }
                  >
                    {paquete.cifras.map((cifra) => (
                      <div>
                        <span class="text-3xl font-light sm:text-4xl">{cifra.n}</span>
                        <span
                          class={
                            paquete.destacado
                              ? 'text-background/50 mt-1 block text-[10px] font-medium tracking-widest uppercase'
                              : 'text-ink-500 mt-1 block text-[10px] font-medium tracking-widest uppercase'
                          }
                        >
                          {cifra.etiqueta}
                        </span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  /*
    Efecto "magic card": un halo que sigue al cursor y un anillo que ilumina el
    borde a su paso. Replicado en CSS + unas líneas de JS en vez de traer el
    componente React de magicui: seis islas para un hover decorativo es el
    coste que CLAUDE.md dice evitar cuando el efecto sale en CSS.

    Los dos pseudoelementos van por encima del contenido (los posicionados
    pintan después del flujo), por eso las alfas son bajas y pointer-events
    va en none. El anillo usa la máscara de exclusión clásica: pinta todo y
    recorta el interior, dejando solo 1px de borde.
  */
  .tarjeta-magica {
    position: relative;
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }

  .tarjeta-magica::before,
  .tarjeta-magica::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  /* Halo interior */
  .tarjeta-magica::before {
    background: radial-gradient(
      380px circle at var(--mx, 50%) var(--my, 50%),
      var(--halo),
      transparent 70%
    );
  }

  /* Anillo del borde */
  .tarjeta-magica::after {
    padding: 1px;
    background: radial-gradient(
      300px circle at var(--mx, 50%) var(--my, 50%),
      var(--anillo),
      transparent 70%
    );
    /* webkit primero y estándar al final: -webkit-mask es alias de `mask` en
       Chromium, así que puesto después reseteaba mask-composite a `add` y el
       degradado se pintaba entero (una nube) en vez de solo el anillo. */
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
  }

  /* Solo con puntero fino: en táctil no hay cursor que seguir. */
  @media (hover: hover) and (pointer: fine) {
    .tarjeta-magica:hover::before,
    .tarjeta-magica:hover::after {
      opacity: 1;
    }

    /*
      La card se levanta y suelta sombra. Una sombra normal sería invisible
      aquí, pero #191919 no es negro puro: con mucha alfa y mucho radio se
      percibe el oscurecimiento — y el movimiento hace el resto.
    */
    .tarjeta-magica:hover {
      transform: translateY(-6px);
      box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.55);
    }
  }

  /*
    Sobre la card oscura, halo y anillo en crema: se lee como luz. Sobre la
    crema solo el anillo — un "brillo" oscuro no existe, y el halo en tinta
    se veía como una mancha flotando sobre la card.
  */
  .magica-oscura {
    --halo: rgb(244 242 235 / 0.05);
    --anillo: rgb(244 242 235 / 0.4);
  }

  .magica-clara {
    --halo: transparent;
    --anillo: rgb(25 25 25 / 0.4);
  }
</style>

<script>
  // Posición del cursor relativa a cada card, en variables CSS que consumen
  // los dos pseudoelementos. Solo se engancha donde hay puntero fino.
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    for (const card of document.querySelectorAll<HTMLElement>('.tarjeta-magica')) {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    }
  }
</script>
