---
/**
 * Sección de servicios de la home. El contenido sale de los documentos de
 * precios del estudio (SHO-BR / SHO-CP / SHO-RS), sin los precios: aquí la
 * sección presenta el servicio, no cotiza.
 *
 * Jerarquía sin sombras (sobre #191919 no se ven): los paquetes van en cards
 * con superficie `ink-50`, y el recomendado se invierte a crema (`ink-950`),
 * que es el mayor contraste disponible en la paleta. Las cifras grandes
 * (03 poses, 05 applications) replican la ficha de los documentos originales.
 */
const servicios = [
  {
    numero: '01',
    titulo: 'Brand Identity',
    descripcion:
      'Visual identity built from the logo to its applications. Two packages depending on where your business is: start with the essentials, or open the doors with everything ready.',
    paquetes: [
      {
        nombre: 'Essential',
        detalle: 'The essentials to get started',
        incluye: [
          'Logo design',
          'Logo variants',
          'Colour palette',
          'Typography',
          'Brand presentation',
          'Profile picture and cover for social media',
          'Story highlight covers',
          'Ready-to-use files',
        ],
      },
      {
        nombre: 'Complete',
        detalle: 'Everything ready for opening day',
        destacado: true,
        incluye: [
          'Everything in Essential',
          'Initial social media post design',
          'Brand applications tailored to your business',
          'Complete brand manual',
          'Files ready for print and digital media',
        ],
        cifras: [
          { n: '05', etiqueta: 'Applications' },
          { n: '01', etiqueta: 'Brand manual' },
        ],
      },
    ],
    nota: 'Applications can be menus, business cards, uniforms, stationery, banners, labels, packaging or flyers — whatever your business actually uses.',
  },
  {
    numero: '02',
    titulo: 'Character Design',
    descripcion:
      'A mascot with a personality of its own for your brand. Original design, ready-to-use poses, and files delivered in the formats you need.',
    paquetes: [
      {
        nombre: 'Essential',
        detalle: 'Character and essential poses',
        incluye: [
          'Original character design',
          'Versions for light and dark backgrounds',
          'Delivery in transparent PNG',
        ],
        cifras: [{ n: '03', etiqueta: 'Poses' }],
      },
      {
        nombre: 'Complete',
        detalle: 'With animation and stickers',
        destacado: true,
        incluye: [
          'Original character design',
          'Animated GIFs for stories and social media',
          'Sticker version',
          'Print-ready sticker files',
          'Delivery in PNG, GIF and JPG',
        ],
        cifras: [
          { n: '04', etiqueta: 'Poses' },
          { n: '02', etiqueta: 'Animated GIFs' },
        ],
      },
    ],
  },
  {
    numero: '03',
    titulo: 'Social Media',
    descripcion:
      'Monthly strategy, design and publishing. A consistent system to build presence and grow the brand.',
    paquetes: [
      {
        nombre: 'Essential plan',
        detalle: 'Monthly · strategy and ongoing content',
        incluye: [
          'Content strategy',
          'Monthly planning and publishing calendar',
          'Content design and copywriting',
          'Scheduling and publishing',
        ],
        cifras: [{ n: '12', etiqueta: 'Posts a month' }],
      },
      {
        nombre: 'Full plan',
        detalle: 'Monthly · content, photo and video',
        destacado: true,
        incluye: [
          'Everything in the Essential plan',
          'Monthly photo and video session',
          'Photo and video editing',
          'Content adapted for social media',
        ],
        cifras: [
          { n: '12', etiqueta: 'Posts a month' },
          { n: '01', etiqueta: 'Photo session' },
        ],
      },
    ],
    nota: 'Plans run for a minimum of three months — consistency is what makes a strategy work. Photo sessions are also available on their own: 15 edited photos and 3 short videos, shot on site and delivered ready to post.',
  },
];
---

<section id="services" class="mt-24 scroll-mt-28">
  <h2 class="text-ink-500 text-sm font-medium tracking-widest uppercase">Services</h2>

  <div class="mt-12 flex flex-col gap-20 sm:gap-24">
    {
      servicios.map((servicio) => (
        <article>
          <header class="max-w-2xl">
            <span class="text-ink-500 text-sm" aria-hidden="true">
              {servicio.numero}
            </span>
            <h3 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
              {servicio.titulo}
            </h3>
            <p class="text-ink-700 mt-4 font-light text-pretty">{servicio.descripcion}</p>
          </header>

          <div class="mt-8 grid gap-4 sm:gap-6 lg:grid-cols-2">
            {servicio.paquetes.map((paquete) => (
              <div
                class={
                  paquete.destacado
                    ? 'bg-ink-950 text-background flex flex-col rounded-3xl p-7 sm:rounded-[2rem] sm:p-9'
                    : 'bg-ink-50 border-ink-100 flex flex-col rounded-3xl border p-7 sm:rounded-[2rem] sm:p-9'
                }
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h4 class="text-xl font-medium tracking-tight sm:text-2xl">
                      {paquete.nombre}
                    </h4>
                    <p
                      class={
                        paquete.destacado
                          ? 'text-background/60 mt-1 text-sm font-light'
                          : 'text-ink-500 mt-1 text-sm font-light'
                      }
                    >
                      {paquete.detalle}
                    </p>
                  </div>
                  {paquete.destacado && (
                    <span class="border-background/25 mt-1 shrink-0 rounded-full border px-3 py-1 text-[10px] font-medium tracking-widest uppercase">
                      Recommended
                    </span>
                  )}
                </div>

                <ul class="mt-7 mb-8 flex flex-col gap-2.5">
                  {paquete.incluye.map((item) => (
                    <li
                      class={
                        paquete.destacado
                          ? 'text-background/80 flex gap-3 font-light'
                          : 'text-ink-700 flex gap-3 font-light'
                      }
                    >
                      <span
                        class={
                          paquete.destacado
                            ? 'text-background/35 select-none'
                            : 'text-ink-300 select-none'
                        }
                        aria-hidden="true"
                      >
                        —
                      </span>
                      {item}
                    </li>
                  ))}
                </ul>

                {paquete.cifras && (
                  <div
                    class={
                      paquete.destacado
                        ? 'border-background/15 mt-auto flex gap-10 border-t pt-6 sm:gap-14'
                        : 'border-ink-100 mt-auto flex gap-10 border-t pt-6 sm:gap-14'
                    }
                  >
                    {paquete.cifras.map((cifra) => (
                      <div>
                        <span class="text-3xl font-light sm:text-4xl">{cifra.n}</span>
                        <span
                          class={
                            paquete.destacado
                              ? 'text-background/50 mt-1 block text-[10px] font-medium tracking-widest uppercase'
                              : 'text-ink-500 mt-1 block text-[10px] font-medium tracking-widest uppercase'
                          }
                        >
                          {cifra.etiqueta}
                        </span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>

          {servicio.nota && (
            <p class="text-ink-500 mt-6 max-w-[72ch] text-sm font-light text-pretty">
              {servicio.nota}
            </p>
          )}
        </article>
      ))
    }
  </div>
</section>
