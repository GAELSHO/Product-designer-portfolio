<section id="services" class="mt-24 scroll-mt-28">
  {/* Título de sección al peso de la casa: grande y en mayúsculas, con la
      línea debajo. Las líneas entre servicios las pone el divide-y. */}
  <h2 class="text-[clamp(2.25rem,5.5vw,3.75rem)] font-semibold tracking-tight uppercase">
    Our Services
  </h2>

  <div class="border-ink-100 divide-ink-100 mt-8 divide-y border-t">
    {
      servicios.map((servicio) => (
        <article class="grid gap-8 py-14 sm:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:gap-16">
          {/* Columna izquierda: 01.Título en grande y descripción.
              En desktop se queda pegada mientras las cards hacen scroll. */}
          <div class="lg:sticky lg:top-24 lg:self-start">
            <h3 class="text-[clamp(1.75rem,3.5vw,2.75rem)] leading-tight font-semibold tracking-tight text-balance">
              <span class="text-ink-500">{servicio.numero}.</span>
              {servicio.titulo}
            </h3>
            <p class="text-ink-700 mt-5 max-w-[46ch] font-light text-pretty">
              {servicio.descripcion}
            </p>
          </div>

          {/* Columna derecha: las cards una encima de otra. */}
          <div class="flex flex-col gap-4 sm:gap-6">
            {servicio.paquetes.map((paquete) => (
              <div
                class={
                  paquete.completo
                    ? 'tarjeta-magica magica-oscura bg-ink-50 border-ink-100 flex flex-col rounded-3xl border p-7 sm:rounded-[2rem] sm:p-9'
                    : 'tarjeta-magica magica-clara bg-ink-950 text-background flex flex-col rounded-3xl p-7 sm:rounded-[2rem] sm:p-9'
                }
              >
                <div class="flex items-center gap-3">
                  <h4 class="text-2xl font-semibold tracking-tight sm:text-3xl">{paquete.nombre}</h4>
                  {paquete.completo && (
                    <span class="border-ink-300/40 bg-ink-100 text-acento flex size-9 items-center justify-center rounded-xl border">
                      <span class="sr-only">Recommended</span>
                      <svg
                        class="size-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        {iconos.destello.map((d) => (
                          <path d={d} />
                        ))}
                      </svg>
                    </span>
                  )}
                </div>

                <p
                  class={
                    paquete.completo
                      ? 'text-ink-500 mt-1.5 font-light'
                      : 'text-background/60 mt-1.5 font-light'
                  }
                >
                  {paquete.detalle}
                </p>

                {/* Regla corta bajo el subtítulo, como en la referencia. */}
                <span
                  class={
                    paquete.completo
                      ? 'bg-acento mt-5 block h-0.5 w-14 rounded-full'
                      : 'bg-background mt-5 block h-0.5 w-14 rounded-full'
                  }
                  aria-hidden="true"
                />

                <ul
                  class={
                    paquete.completo
                      ? 'divide-ink-100 mt-6 mb-8 divide-y'
                      : 'divide-background/10 mt-6 mb-8 divide-y'
                  }
                >
                  {paquete.filas.map((fila) => (
                    <li class="flex items-start gap-4 py-4 first:pt-0 last:pb-0">
                      <span
                        class={
                          paquete.completo
                            ? 'border-ink-300/40 bg-ink-100 text-acento flex size-12 shrink-0 items-center justify-center rounded-2xl border'
                            : 'border-background/20 text-background flex size-12 shrink-0 items-center justify-center rounded-2xl border'
                        }
                        aria-hidden="true"
                      >
                        <svg
                          class="size-5"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          {iconos[fila.icono].map((d) => (
                            <path d={d} />
                          ))}
                        </svg>
                      </span>
                      <div class="min-w-0">
                        <h5 class="font-medium">{fila.titulo}</h5>
                        <p
                          class={
                            paquete.completo
                              ? 'text-ink-500 mt-0.5 text-sm font-light text-pretty'
                              : 'text-background/60 mt-0.5 text-sm font-light text-pretty'
                          }
                        >
                          {fila.detalle}
                        </p>
                      </div>
                    </li>
                  ))}
                </ul>

                {paquete.cifras && (
                  <div
                    class={
                      paquete.completo
                        ? 'border-ink-100 divide-ink-100 mt-auto flex divide-x border-t'
                        : 'border-background/10 divide-background/10 mt-auto flex divide-x border-t'
                    }
                  >
                    {paquete.cifras.map((cifra) => (
                      <div class="pt-6 pr-10 pl-10 first:pl-0 last:pr-0 sm:pr-14 sm:pl-14">
                        <span
                          class={
                            paquete.completo
                              ? 'text-acento text-3xl font-light sm:text-4xl'
                              : 'text-background text-3xl font-light sm:text-4xl'
                          }
                        >
                          {cifra.n}
                        </span>
                        <span
                          class={
                            paquete.completo
                              ? 'text-ink-500 mt-1 block text-[10px] font-medium tracking-widest uppercase'
                              : 'text-background/50 mt-1 block text-[10px] font-medium tracking-widest uppercase'
                          }
                        >
                          {cifra.etiqueta}
                        </span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  /*
    Efecto "magic card": un halo que sigue al cursor y un anillo que ilumina el
    borde a su paso. Replicado en CSS + unas líneas de JS en vez de traer el
    componente React de magicui: seis islas para un hover decorativo es el
    coste que CLAUDE.md dice evitar cuando el efecto sale en CSS.

    Los dos pseudoelementos van por encima del contenido (los posicionados
    pintan después del flujo), por eso las alfas son bajas y pointer-events
    va en none. El anillo usa la máscara de exclusión clásica: pinta todo y
    recorta el interior, dejando solo 1px de borde.
  */
  .tarjeta-magica {
    position: relative;
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }

  .tarjeta-magica::before,
  .tarjeta-magica::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  /* Halo interior */
  .tarjeta-magica::before {
    background: radial-gradient(
      380px circle at var(--mx, 50%) var(--my, 50%),
      var(--halo),
      transparent 70%
    );
  }

  /* Anillo del borde */
  .tarjeta-magica::after {
    padding: 1px;
    background: radial-gradient(
      300px circle at var(--mx, 50%) var(--my, 50%),
      var(--anillo),
      transparent 70%
    );
    /* webkit primero y estándar al final: -webkit-mask es alias de `mask` en
       Chromium, así que puesto después reseteaba mask-composite a `add` y el
       degradado se pintaba entero (una nube) en vez de solo el anillo. */
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
  }

  /* Solo con puntero fino: en táctil no hay cursor que seguir. */
  @media (hover: hover) and (pointer: fine) {
    .tarjeta-magica:hover::before,
    .tarjeta-magica:hover::after {
      opacity: 1;
    }

    /*
      La card se levanta y suelta sombra. Una sombra normal sería invisible
      aquí, pero #191919 no es negro puro: con mucha alfa y mucho radio se
      percibe el oscurecimiento — y el movimiento hace el resto.
    */
    .tarjeta-magica:hover {
      transform: translateY(-6px);
      box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.55);
    }
  }

  /*
    Sobre la card oscura, halo y anillo en crema: se lee como luz. Sobre la
    crema solo el anillo — un "brillo" oscuro no existe, y el halo en tinta
    se veía como una mancha flotando sobre la card.
  */
  .magica-oscura {
    --halo: rgb(244 242 235 / 0.05);
    --anillo: rgb(244 242 235 / 0.4);
  }

  .magica-clara {
    --halo: transparent;
    --anillo: rgb(25 25 25 / 0.4);
  }
</style>

<script>
  // Posición del cursor relativa a cada card, en variables CSS que consumen
  // los dos pseudoelementos. Solo se engancha donde hay puntero fino.
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    for (const card of document.querySelectorAll<HTMLElement>('.tarjeta-magica')) {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    }
  }
</script>
