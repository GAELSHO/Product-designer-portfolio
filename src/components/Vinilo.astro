---
/**
 * El disco de "About Me": la portada del álbum recortada en círculo, con el
 * hueco del centro, girando en bucle, y un control debajo con la ficha del tema.
 *
 * No suena nada —no hay audio en el repo— y el botón no lo finge: es el control
 * de la rueda. En reposo el disco gira; al pulsar play se para, que es la
 * interacción que se pidió.
 */
import { Image } from 'astro:assets';
import portada from '@/assets/down-to-the-waterline.jpg';

interface Props {
  /** Clases del contenedor, para colocarlo desde fuera. */
  class?: string;
}

const { class: clase } = Astro.props;
---

<div class={clase}>
  <div class="tocadiscos">
    <div class="disco" data-vinilo-disco>
      <Image
        src={portada}
        alt="Cover of the first Dire Straits album: a blurred figure leaning against the wall of an empty, sunlit room."
        widths={[320, 480, 640]}
        sizes="20rem"
        loading="lazy"
      />
    </div>
  </div>

  <div class="mt-6 flex max-w-[20rem] items-center gap-4">
    {/* `aria-pressed` es lo que comunica el estado, así que la etiqueta se
        queda fija: un `aria-label` que cambie a la vez pelearía con él. */}
    <button
      type="button"
      data-vinilo-boton
      aria-pressed="false"
      aria-label="Play Down to the Waterline"
      class="border-ink-100 text-ink-700 hover:border-ink-300 hover:text-ink-950 grid size-12 shrink-0 place-items-center rounded-full border transition-colors"
    >
      <svg class="play size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6 3.5 20 12 6 20.5Z"></path>
      </svg>
      <svg class="pausa size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6 4h4v16H6ZM14 4h4v16h-4Z"></path>
      </svg>
    </button>

    <div class="min-w-0">
      <p class="truncate font-medium">Down to the Waterline</p>
      <p class="text-ink-500 truncate text-sm font-light">Dire Straits</p>
    </div>
  </div>
</div>

<style>
  .tocadiscos {
    position: relative;
    width: 100%;
    max-width: 20rem;
    aspect-ratio: 1;
  }

  /* El aro vive fuera del disco: dentro se lo comería la máscara, que recorta
     todo lo que sale del círculo. Va en el contenedor quieto, no en el que
     gira —de un aro girando no se notaría nada—. */
  .tocadiscos::before {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid var(--color-ink-100);
    border-radius: 50%;
  }

  .disco {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 50%;
    /* El hueco del centro es una máscara y no un círculo pintado con el color
       del fondo: así el agujero es transparente de verdad y no hay que
       repintarlo si algún día se invierte el tema. `closest-side` hace que el
       100% del degradado caiga en el borde de la caja; sin eso el radio se
       mide sobre la diagonal y el hueco sale un 40% más grande. */
    --mascara: radial-gradient(circle closest-side at 50% 50%, transparent 0 6.5%, #000 7%);
    -webkit-mask-image: var(--mascara);
    mask-image: var(--mascara);
    animation: girar 16s linear infinite;
  }

  .disco[data-parado] {
    animation-play-state: paused;
  }

  /* La portada es cuadrada y entra entera: el círculo solo se lleva las cuatro
     esquinas del marco blanco, no la ilustración. Ampliarla para que la
     ilustración llenase el disco (mide 418 de 640, harían falta 1.55) deja un
     recorte abstracto en el que ya no se reconoce la portada. */
  .disco :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes girar {
    to {
      transform: rotate(360deg);
    }
  }

  /* `global.css` recorta cualquier duración a 0.01ms, y sobre un `infinite`
     eso no es "sin animación" sino un parpadeo: aquí se apaga entera. */
  @media (prefers-reduced-motion: reduce) {
    .disco {
      animation: none;
    }
  }

  button[aria-pressed='false'] .pausa,
  button[aria-pressed='true'] .play {
    display: none;
  }
</style>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-vinilo-boton]');
  const disco = document.querySelector<HTMLElement>('[data-vinilo-disco]');

  boton?.addEventListener('click', () => {
    const sonando = boton.getAttribute('aria-pressed') === 'true';
    boton.setAttribute('aria-pressed', String(!sonando));
    disco?.toggleAttribute('data-parado', !sonando);
  });
</script>
