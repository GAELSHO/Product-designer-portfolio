---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

/**
 * Tercera pieza del case study de AMPIA: el logotipo sobre el degradado de
 * marca. Era el board 03 de las dos secuencias.
 *
 * Aquí lo que sale de la imagen no es texto sino el fondo: el board era un
 * archivo de 5120px que se descargaba entero para pintar un degradado. Lo único
 * que no es CSS es el logotipo, y va en SVG en línea: ni una petición más.
 *
 * El fondo va en tres niveles, y el orden importa:
 *
 *   1. `.marca`      el eje diagonal — la identidad del board, fija
 *   2. `.brillos`    cinco manchas de color, cada una con su órbita
 *   3. `.esquinas`   las dos esquinas repintadas por encima
 *
 * El nivel 3 existe porque las manchas, al orbitar, pasan por todas partes: sin
 * él el verde acababa en la esquina del azul noche y el panel viraba entero.
 * Repintar las esquinas encima deja el movimiento donde tiene sitio —el centro—
 * sin tocar lo que define la marca. Lleva `z-index` explícito y no orden en el
 * DOM: un `::after` se inserta como último hijo y se pintaría por encima.
 *
 * **Los colores son los cinco de la paleta y nada más.** Se probaron azules
 * pálidos, casi blancos, para dar luz: sobre el azul noche de la esquina
 * superior derecha no dan luz sino un gris sucio, porque mezclar un tono
 * desaturado con uno oscuro baja el croma de los dos. Todo lo que se mueve va
 * saturado; la luz la pone el color, no el blanco.
 *
 * Proporciones medidas del board original: el logotipo ocupa el 34.5% del ancho
 * del panel en desktop y el 55.3% en móvil, centrado en ambos.
 */
interface Props {
  /**
   * `AMPIA logo claro.svg`, importado desde el `.mdx`. Astro convierte un
   * import de `.svg` en un componente que se pinta en línea, así que el
   * logotipo no es una imagen que se descargue: es vectorial, va nítido a
   * cualquier densidad y a cualquier zoom, y no cuesta ninguna petición.
   *
   * Antes era el PNG de 7770px. No se veía mal —el navegador nunca lo
   * ampliaba— pero un raster a 1:1 es el techo, no lo máximo: el vector se
   * rasteriza a la resolución real del dispositivo, sea la que sea.
   */
  logo: AstroComponentFactory;
}

const { logo: Logo } = Astro.props;
---

<div class="marca">
  <div class="brillos" aria-hidden="true">
    <span class="b1"></span>
    <span class="b2"></span>
    <span class="b3"></span>
    <span class="b4"></span>
    <span class="b5"></span>
  </div>

  <span class="esquinas" aria-hidden="true"></span>

  {/* Un `<svg>` no tiene texto alternativo propio: el nombre accesible lo dan
      `role="img"` y el `aria-label`, que es lo que hacía el `alt`. */}
  <Logo class="logo" role="img" aria-label="AMPIA" />
</div>

<style>
  .marca {
    container-type: inline-size;
    position: relative;
    /* Las manchas se salen del panel al orbitar; esto las recorta. */
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 5;
    /*
      Nivel 1: el eje. Las esquinas medidas del board son verde `#75f266`
      abajo-izquierda, azul claro `#6db6e2` arriba-izquierda, azul noche
      `#050a24` arriba-derecha y azul medio `#1e3a6e` abajo-derecha. Eso NO es
      una diagonal limpia —si lo fuera, las dos esquinas de en medio darían el
      mismo color, y la de arriba es mucho más clara— sino un eje casi
      horizontal con dos esquinas marcadas encima.
    */
    background: linear-gradient(
      100deg,
      #66acd9 0%,
      #3f8ed6 22%,
      #0a63cf 56%,
      #1c3a6b 100%
    );
  }

  @media (min-width: 40rem) {
    .marca {
      aspect-ratio: 16 / 9;
    }
  }

  /*
    Nivel 2: cinco manchas, cada una de un color de la paleta y con su propia
    órbita y duración (5, 6, 7, 8 y 9 segundos). Ninguna duración divide a otra
    a propósito: así la combinación tarda cuarenta minutos en volver al mismo
    fotograma y nunca se lee como un bucle. Si algún día se cambian, conviene
    mantener esa propiedad — con duraciones que se dividan entre sí (5 y 10,
    por ejemplo) el bucle se nota enseguida.

    Los bordes se difuminan con el propio `radial-gradient` —de color a
    `transparent`— en vez de con `filter: blur()`. El resultado se ve igual de
    suave y no obliga al navegador a desenfocar un panel entero en cada
    fotograma, que es lo caro.
  */
  .brillos {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .brillos span {
    position: absolute;
    display: block;
    border-radius: 50%;
    /* El movimiento va en `transform`, que se compone en GPU. */
    will-change: transform;
  }

  .b1 {
    width: 95cqw;
    height: 95cqw;
    left: -25cqw;
    bottom: -40cqw;
    background: radial-gradient(circle, rgb(117 242 104 / 0.85) 0%, rgb(117 242 104 / 0) 62%);
    --radio: 20%;
    animation: orbita 5s linear infinite;
  }

  .b2 {
    width: 85cqw;
    height: 85cqw;
    left: 8cqw;
    top: -18cqw;
    background: radial-gradient(circle, rgb(102 172 217 / 0.8) 0%, rgb(102 172 217 / 0) 62%);
    --radio: 16%;
    animation: orbitaInversa 7s linear infinite;
  }

  .b3 {
    width: 100cqw;
    height: 100cqw;
    right: -22cqw;
    top: 12cqw;
    background: radial-gradient(circle, rgb(2 107 228 / 0.85) 0%, rgb(2 107 228 / 0) 60%);
    --radio: 24%;
    animation: orbitaAncha 6s linear infinite;
  }

  .b4 {
    width: 80cqw;
    height: 80cqw;
    right: 4cqw;
    bottom: -26cqw;
    background: radial-gradient(circle, rgb(20 57 128 / 0.85) 0%, rgb(20 57 128 / 0) 62%);
    --radio: 18%;
    animation: orbitaInversa 9s linear infinite;
  }

  .b5 {
    width: 70cqw;
    height: 70cqw;
    left: 26cqw;
    top: 22cqw;
    background: radial-gradient(circle, rgb(2 107 228 / 0.7) 0%, rgb(2 107 228 / 0) 60%);
    --radio: 22%;
    animation: orbitaAncha 8s linear infinite;
  }

  /*
    Nivel 3: las dos esquinas por encima del movimiento. Las paradas
    intermedias de alfa son para que la caída sea suave: con un salto directo
    de opaco a transparente, la esquina oscura se leía como un disco pegado
    encima en vez de como el final del degradado.
  */
  .esquinas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background:
      radial-gradient(
        92% 102% at 100% 0%,
        #0a1424 0%,
        rgb(10 20 36 / 0.82) 22%,
        rgb(10 20 36 / 0.4) 48%,
        transparent 78%
      ),
      radial-gradient(
        74% 84% at 0% 100%,
        #75f268 0%,
        rgb(117 242 104 / 0.66) 26%,
        transparent 72%
      );
  }

  /* El verde respira en su propia capa, anclado a su esquina: escalar
     `.esquinas` entera sacaba del panel la esquina opuesta y la aclaraba. */
  .esquinas::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(46% 54% at 0% 100%, rgb(117 242 104 / 0.8) 0%, transparent 62%);
    transform-origin: 0% 100%;
    animation: respiraVerde 4s ease-in-out infinite alternate;
  }

  /* El SVG trae el mismo aire alrededor que traía el PNG: el trazo ocupa el
     79.2% del ancho del `viewBox` (el PNG medía 79.3%), así que los anchos no
     cambian. Para que el logotipo se lea al 34.5% del panel —lo medido del
     board original— la caja tiene que medir 34.5 / 0.792 = 43.5%; en móvil,
     55.3 / 0.792 = 69.7%. */
  .logo {
    position: relative;
    z-index: 2;
    width: 69.7cqw;
    height: auto;
    /* El SVG pinta con `currentColor`. */
    color: #fff;
  }

  @media (min-width: 40rem) {
    .logo {
      width: 43.5cqw;
    }
  }

  /*
    Órbitas continuas y `linear`, no vaivenes con `ease-in-out`. El motivo es
    que se vea moverse **en el primer segundo**: un vaivén suavizado pasa los
    extremos de cada ciclo casi parado, así que quien llega en ese momento ve
    una imagen quieta. Girando en redondo y a ritmo constante no hay ningún
    instante lento.

    La segunda rotación deshace la primera: la mancha recorre el círculo sin
    girar sobre sí misma. El radio lo pone cada una con `--radio`.
  */
  @keyframes orbita {
    from {
      transform: rotate(0deg) translateX(var(--radio)) rotate(0deg);
    }
    to {
      transform: rotate(360deg) translateX(var(--radio)) rotate(-360deg);
    }
  }

  @keyframes orbitaInversa {
    from {
      transform: rotate(360deg) translateX(var(--radio)) rotate(-360deg);
    }
    to {
      transform: rotate(0deg) translateX(var(--radio)) rotate(0deg);
    }
  }

  /* Igual que `orbita`, con un latido de escala encima para que las cinco no
     se muevan todas igual. */
  @keyframes orbitaAncha {
    from {
      transform: rotate(0deg) translateX(var(--radio)) rotate(0deg) scale(1);
    }
    50% {
      transform: rotate(180deg) translateX(var(--radio)) rotate(-180deg) scale(1.14);
    }
    to {
      transform: rotate(360deg) translateX(var(--radio)) rotate(-360deg) scale(1);
    }
  }

  @keyframes respiraVerde {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.07);
    }
  }

  /*
    `global.css` recorta las duraciones a 0.01ms con reduced-motion, y en una
    animación `infinite` eso deja el fondo parpadeando. Se apagan todas: el
    degradado se queda quieto, que es exactamente el board original.
  */
  @media (prefers-reduced-motion: reduce) {
    .brillos span,
    .esquinas::after {
      animation: none;
    }
  }
</style>
