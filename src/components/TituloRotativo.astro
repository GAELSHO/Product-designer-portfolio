---
import TituloSweep from '@/components/TituloSweep';

/**
 * Título del header. La palabra central rota entre disciplinas con el barrido
 * de color de `DiaTextReveal`.
 *
 * El HTML servido trae el título completo dos veces:
 * - una versión plana en `sr-only`, que es la que leen buscadores y lectores
 *   de pantalla (la parte animada va con `aria-hidden`, para que nadie oiga el
 *   texto cambiar solo);
 * - la versión visual, donde Astro pre-renderiza la primera palabra.
 *
 * Ojo con el modo sin JS: el componente pinta el texto con `color:transparent`
 * y un degradado que al principio del barrido es transparente entero, así que
 * sin hidratar la palabra no se vería. El `<noscript>` de abajo la devuelve a
 * blanco sólido.
 */
const palabras = ['Brand', 'WEB', 'UX/UI'];
const textoPlano = `Gael SHO | ${palabras.join(', ')} Designer`;
---

<h1 class="text-center text-4xl font-light tracking-tight text-balance sm:text-6xl lg:text-7xl">
  <span class="sr-only">{textoPlano}</span>

  <span
    aria-hidden="true"
    class="inline-flex flex-wrap items-baseline justify-center gap-x-[0.28em] gap-y-1"
  >
    <span class="font-bold">Gael SHO |</span>
    <TituloSweep client:load />
    <span>Designer</span>
  </span>
</h1>

<noscript>
  <style>
    .titulo-sweep {
      color: var(--color-foreground) !important;
      background-image: none !important;
    }
  </style>
</noscript>
