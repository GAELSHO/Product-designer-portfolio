---
import { withBase } from '@/lib/url';

import type { CollectionEntry } from 'astro:content';

interface Props {
  /** Id de la entrada en la colección, que es el segmento de URL. */
  slug: string;
  datos: CollectionEntry<'work'>['data'];
  /** La primera card del listado: se carga sin esperar, está sobre el fold. */
  prioritaria?: boolean;
}

const { slug, datos: proyecto, prioritaria = false } = Astro.props;

// Vertical en móvil (4:5, para que la card ocupe pantalla) y panorámica en
// desktop, donde va a ancho completo y una 4:5 mediría más de 1300px de alto.
const proporcion = 'aspect-[4/5] sm:aspect-[16/9]';

// El contenido está siempre visible por defecto (móvil y táctil). Solo en
// dispositivos con puntero fino se esconde y aparece en hover.
const revelar =
  'opacity-100 transition-opacity duration-300 ease-out hover-device:opacity-0 hover-device:group-focus-visible:opacity-100 hover-device:group-hover:opacity-100';
---

<a
  href={withBase(`/work/${slug}`)}
  class={`group relative block overflow-hidden rounded-3xl sm:rounded-[2rem] ${proporcion}`}
>
  {/*
    Dos recortes, no uno escalado: la card es 4:5 en móvil y 16:9 en desktop, y
    `object-cover` recorta para llenar. Con una sola fuente, el breakpoint que
    no coincide se queda viendo el 45% central de la pieza.

    El `40rem` es el `sm:` de Tailwind — si cambia la proporción por breakpoint
    en `proporcion`, esta media query tiene que moverse con ella.

    `portadaMovil` es opcional: sin ella se usa la de desktop en ambos, que es
    lo que hacen ahora los placeholders sin recorte vertical.
  */}
  <picture class="block h-full w-full">
    {proyecto.portadaMovil && <source media="(min-width: 40rem)" srcset={withBase(proyecto.portada)} />}
    <img
      src={withBase(proyecto.portadaMovil ?? proyecto.portada)}
      alt={proyecto.portadaAlt}
      loading={prioritaria ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 ease-out hover-device:group-focus-visible:scale-105 hover-device:group-hover:scale-105"
    />
  </picture>

  <div
    class={`absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-transparent ${revelar}`}
    aria-hidden="true"
  >
  </div>

  <div class={`absolute inset-0 flex items-end gap-4 p-5 text-white sm:p-8 ${revelar}`}>
    <div class="min-w-0 flex-1">
      <h3 class="text-2xl font-semibold tracking-tight sm:text-4xl">{proyecto.titulo}</h3>
      <p class="mt-1 truncate text-sm text-white/85 sm:text-base">{proyecto.descripcion}</p>
      <ul class="mt-3 flex flex-wrap gap-2 sm:mt-4">
        {
          proyecto.tags.map((tag) => (
            <li class="rounded-full border border-white/70 px-3 py-1 text-xs sm:px-4 sm:py-1.5 sm:text-sm">
              {tag}
            </li>
          ))
        }
      </ul>
    </div>

    <svg
      class="size-8 shrink-0 self-end sm:size-12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17 17 7" />
      <path d="M8 7h9v9" />
    </svg>
  </div>
</a>
