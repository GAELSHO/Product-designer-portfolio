---
import { withBase } from '@/lib/url';

interface Props {
  proyecto: {
    slug: string;
    titulo: string;
    descripcion: string;
    tags: string[];
    portada: string;
    portadaAlt: string;
  };
  /** La card destacada ocupa el ancho completo y es más panorámica. */
  destacada?: boolean;
}

const { proyecto, destacada = false } = Astro.props;

const proporcion = destacada ? 'aspect-[4/3] sm:aspect-[21/9]' : 'aspect-[4/3] sm:aspect-square';

// El contenido está siempre visible por defecto (móvil y táctil). Solo en
// dispositivos con puntero fino se esconde y aparece en hover.
const revelar =
  'opacity-100 transition-opacity duration-300 ease-out hover-device:opacity-0 hover-device:group-focus-visible:opacity-100 hover-device:group-hover:opacity-100';
---

<a
  href={withBase(`/proyectos/${proyecto.slug}`)}
  class={`group relative block overflow-hidden rounded-3xl sm:rounded-[2rem] ${proporcion}`}
>
  <img
    src={withBase(proyecto.portada)}
    alt={proyecto.portadaAlt}
    loading={destacada ? 'eager' : 'lazy'}
    decoding="async"
    class="h-full w-full object-cover transition-transform duration-500 ease-out hover-device:group-focus-visible:scale-105 hover-device:group-hover:scale-105"
  />

  <div
    class={`absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-transparent ${revelar}`}
    aria-hidden="true"
  >
  </div>

  <div class={`absolute inset-0 flex items-end gap-4 p-5 text-white sm:p-8 ${revelar}`}>
    <div class="min-w-0 flex-1">
      <h3 class="text-2xl font-semibold tracking-tight sm:text-4xl">{proyecto.titulo}</h3>
      <p class="mt-1 truncate text-sm text-white/85 sm:text-base">{proyecto.descripcion}</p>
      <ul class="mt-3 flex flex-wrap gap-2 sm:mt-4">
        {
          proyecto.tags.map((tag) => (
            <li class="rounded-full border border-white/70 px-3 py-1 text-xs sm:px-4 sm:py-1.5 sm:text-sm">
              {tag}
            </li>
          ))
        }
      </ul>
    </div>

    <svg
      class="size-8 shrink-0 self-end sm:size-12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17 17 7" />
      <path d="M8 7h9v9" />
    </svg>
  </div>
</a>
