---
import DockNav from '@/components/DockNav';
---

{/*
  El dock es la navegación principal, así que va envuelto en <nav> — el
  componente de unlumen renderiza un div y no aporta esa semántica.

  `client:idle` en vez de `client:load`: Astro pinta el dock en el HTML
  estático (los <a> funcionan sin JS), y la magnificación y los tooltips
  se activan cuando el navegador está desocupado.
*/}
{/*
  `top-10` en desktop y no `top-4`: al magnificar, el icono crece hacia arriba
  (va anclado por abajo) y con el dock pegado al borde se recortaba. En móvil
  no hay puntero, así que no hay magnificación y basta con `top-6`.
*/}
<div class="pointer-events-none fixed inset-x-0 top-6 z-50 flex justify-center px-4 sm:top-10">
  <nav class="pointer-events-auto max-w-full" aria-label="Principal">
    <DockNav client:idle />
  </nav>
</div>
