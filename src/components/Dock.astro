---
import { withBase } from '@/lib/url';

const enlaces = [
  { href: '/', label: 'Inicio' },
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/#sobre-mi', label: 'Sobre mí' },
  { href: 'mailto:gaelsho10@gmail.com', label: 'Contacto', externo: true },
];
---

<div class="pointer-events-none fixed inset-x-0 top-4 z-50 flex justify-center px-4">
  <nav
    class="bg-ink-50/90 pointer-events-auto max-w-full overflow-x-auto rounded-full px-2 py-2 shadow-sm backdrop-blur-md [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    aria-label="Principal"
  >
    <ul class="text-ink-700 flex items-center gap-0.5 text-xs sm:gap-1 sm:text-sm">
      {
        enlaces.map((enlace) => (
          <li>
            <a
              class="hover:bg-white hover:text-ink-950 block rounded-full px-2.5 py-1.5 whitespace-nowrap transition-colors sm:px-4"
              href={enlace.externo ? enlace.href : withBase(enlace.href)}
            >
              {enlace.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
